# ===========================================
# Production Environment Configuration
# ===========================================

# Domain Configuration
APP_URL=https://pricebrain.example.com
API_URL=https://api.pricebrain.example.com

# PostgreSQL
DATABASE_HOST=postgres.pricebrain.svc.cluster.local
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=<SET_IN_SECRETS>
DATABASE_NAME=pricebrain

# Redis
REDIS_HOST=redis.pricebrain.svc.cluster.local
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch.pricebrain.svc.cluster.local:9200

# JWT Authentication
JWT_SECRET=<SET_IN_SECRETS>
JWT_EXPIRES_IN=7d

# OpenAI (Optional - for AI features)
OPENAI_API_KEY=<SET_IN_SECRETS>

# Resend Email (Optional - for email notifications)
RESEND_API_KEY=<SET_IN_SECRETS>

# Web Push Notifications (Optional)
VAPID_PUBLIC_KEY=<SET_IN_SECRETS>
VAPID_PRIVATE_KEY=<SET_IN_SECRETS>

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=https://pricebrain.example.com

# SSL/TLS
# Certificates are automatically managed by cert-manager
# Let's Encrypt is configured for automatic SSL
