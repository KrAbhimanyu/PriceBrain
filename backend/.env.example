# Application
NODE_ENV=development
PORT=4000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pricebrain
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# CORS
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.com

# AI Service (OpenAI)
OPENAI_API_KEY=your_openai_api_key

# Application URL
APP_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password

# Queue (Bull)
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=

# Affiliate APIs
AMAZON_ASSOCIATE_TAG=your_amazon_tag
FLIPKART_AFFILIATE_ID=your_flipkart_id
FLIPKART_AFFILIATE_TOKEN=your_flipkart_token

# Email (Resend - for production)
RESEND_API_KEY=re_your_resend_api_key

# Push Notifications (Web Push)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:noreply@pricebrain.com

# Scraper Configuration
SCRAPER_PROXY_URL=  # Optional: HTTP proxy for scraping (e.g., http://proxy.example.com:8080)

# AI Shopping Assistant (OpenAI)
OPENAI_API_KEY=  # Optional: OpenAI API key for AI features
OPENAI_MODEL=gpt-4o-mini  # Model to use (gpt-4o, gpt-4o-mini, gpt-4-turbo)
