# =============================================
# PriceBrain Environment Configuration
# =============================================

# Application
NODE_ENV=development
PORT=3000
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pricebrain
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/pricebrain

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=change-me-use-strong-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-another-strong-secret-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Kafka/RabbitMQ (for queue system)
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=pricebrain
KAFKA_GROUP_ID=pricebrain-group
RABBITMQ_URL=amqp://localhost:5672

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=pricebrain-uploads

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@pricebrain.com
SMTP_FROM_NAME=PriceBrain
EMAIL_FROM=noreply@pricebrain.com
EMAIL_FROM_NAME=PriceBrain

# Affiliate APIs
AMAZON_ASSOCIATE_TAG=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
MYNTRA_AFFILIATE_ID=
AJIO_AFFILIATE_ID=
CROMA_AFFILIATE_ID=

# AI Service
OPENAI_API_KEY=
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=
AI_MODEL=gpt-4-turbo-preview

# Scraper Configuration
SCRAPER_TIMEOUT=30000
SCRAPER_RETRY_ATTEMPTS=3
PROXY_ROTATION_ENABLED=false
SCRAPER_PROXY_URL=
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_TTL=60
RATE_LIMIT_AUTH_MAX=10

# Security
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
HELMET_CSP=true

# Monitoring & Logging
SENTRY_DSN=
PROMETHEUS_ENABLED=true
METRICS_PORT=3001
LOG_LEVEL=debug
LOG_FORMAT=json

# Cloudflare
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=

# =============================================
# Production Overrides
# =============================================
# For production, use environment-specific files:
# - .env.staging
# - .env.production
# Never commit secrets to version control!
